    {
      "file": "fig_fcas_countries_v4.png",
      "title": "Nigeria and Ethiopia carry the FCAS evidence base",
      "caption": "Studies about each fragile or conflict-affected country, top 20. 1,179 studies (3.2% of all) cover an FCAS country; Nigeria (297) and Ethiopia (184) appear in 41% of them."
    },
    {
      "file": "fig_fcas_trend_v4.png",
      "title": "FCAS research is growing, but list changes exaggerate the jump",
      "caption": "Studies on fragile or conflict-affected countries per year (top) and as a share of country-level studies (bottom). By each year's list the share tripled, 1.8% (2010-14) to 5.4% (2021-25); on a fixed set of countries it rose only from 5.5% to 7.2%."
    },
    {
      "file": "fig_outcome_domains_v4.png",
      "title": "Most studies measure outcomes outside the named health-system goals",
      "caption": "Share of studies investigating each outcome domain (a study can have several). 'Other' tags 57% of studies; among named goals, efficiency in resource use (14%) and financial protection (14%) lead."
    },
    {
      "file": "fig_outcome_other_themes_v4.png",
      "title": "'Other' outcomes are led by access and spending",
      "caption": "Themes within the studies whose outcome domain is tagged 'Other'. Service use, access and coverage (22%) and levels, trends and drivers of spending, prices or funding (19%) are the largest themes."
    },
    {
      "file": "fig_outcome_trend_v4.png",
      "title": "Health outcomes and financial protection gain ground",
      "caption": "Share of each year's studies investigating each named health-system goal, 2010-2025. Improved level/distribution of health rose from 6% to 11% and financial protection from 10% to 14%; the rest barely moved."
    },
    {
      "file": "fig_outcome_by_context_v4.png",
      "title": "FCAS studies look more like low-income than high-income evidence",
      "caption": "Share of studies in each setting that investigate each health-system goal. Versus high-income settings, FCAS studies focus more on financial protection (22% vs 8%) and less on efficiency in resource use (10% vs 16%)."
    }
  ]
