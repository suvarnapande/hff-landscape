    {
      "file": "fig_fcas_countries_v5.png",
      "title": "Nigeria and Ethiopia carry the FCAS evidence base",
      "caption": "Studies about each fragile or conflict-affected country, top 20. 1,449 studies (2.7% of all) cover an FCAS country; Nigeria (361) and Ethiopia (191) appear in 38% of them."
    },
    {
      "file": "fig_fcas_trend_v5.png",
      "title": "FCAS research is growing, but list changes exaggerate the jump",
      "caption": "Studies on fragile or conflict-affected countries per year (top) and as a share of country-level studies (bottom). By each year's list the share tripled, 1.7% (2010-14) to 4.9% (2021-25); on a fixed set of countries it rose only from 4.5% to 6.5%."
    },
    {
      "file": "fig_outcome_domains_v5.png",
      "title": "Most studies measure outcomes outside the named health-system goals",
      "caption": "Share of studies investigating each outcome domain (a study can have several). 'Other' tags 54% of studies; among named goals, equitable distribution of resources (12%) and efficiency in the use of resources (11%) lead."
    },
    {
      "file": "fig_outcome_other_themes_v5.png",
      "title": "'Other' outcomes are led by access and spending",
      "caption": "Themes within the studies whose outcome domain is tagged 'Other'. Service use, access and coverage (29%) and levels, trends and drivers of spending, prices or funding (15%) are the largest themes."
    },
    {
      "file": "fig_outcome_trend_v5.png",
      "title": "Health outcomes and financial protection gain ground",
      "caption": "Share of each year's studies investigating each named health-system goal, 2010-2025. Improved level/distribution of health rose from 8% to 13% and financial protection from 7% to 9%; the rest barely moved."
    },
    {
      "file": "fig_outcome_by_context_v5.png",
      "title": "FCAS studies look more like low-income than high-income evidence",
      "caption": "Share of studies in each setting that investigate each health-system goal. Versus high-income settings, FCAS studies focus more on financial protection (12% vs 6%) and less on efficiency in resource use (8% vs 13%)."
    }
  ]
