  "figures": [
    {
      "file": "fig_oa_trend_v5.png",
      "title": "Open access has become the norm",
      "caption": "Share of each year's studies (with a DOI) that are open access. It rose from 42% in 2010 to 76% in 2025, passing half in 2012."
    },
    {
      "file": "fig_map_oa_author_v5.png",
      "title": "Where open-access research comes from",
      "caption": "Open-access share of studies with at least one author based in each country. Blue = more open access than the average study; red = less. 79 of 98 author countries beat the average study (68%), which the large US output (63% open) pulls down. Among countries with ≥200 studies, Uganda is highest (91%) and Taiwan lowest (60%)."
    },
    {
      "file": "fig_oa_author_countries_v5.png",
      "title": "Authors in lower-income countries publish open access more often",
      "caption": "Open-access share of studies with at least one author based in each country, the 25 most active author countries. Kenya tops the list (86%) and Taiwan is lowest (60%); the average is 77% across middle/low-income author countries vs 72% across high-income ones."
    },
    {
      "file": "fig_oa_author_income_v5.png",
      "title": "Research with lower-income authors is more often open access",
      "caption": "Open-access share by where a study's authors are based (dashed line: all studies). 73% of LMIC-only author teams publish open access and 77% of mixed teams, vs 63% of teams based only in high-income countries."
    }
  ]
